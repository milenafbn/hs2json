cabal-version:      3.0
name:               hs2json
version:            0.1.0.0
synopsis:           Biblioteca para representar JSON e imprimi-lo de forma agradável
description:        Uma pequena biblioteca Haskell que representa valores JSON,
                    faz pretty printing com quebra de linha e indentação e
                    é testada com QuickCheck.
category:           Text
license:            MIT
license-file:       LICENSE
author:             Milena Freire Britto Neves, Ana Iara Loayza Costa
maintainer:         milena.neves@discente.ufma.br
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  SimpleJSON, PutJSON, Prettify, PrettyJSON, QuickTestes
    -- other-modules:
    -- other-extensions:
    build-depends:    base >= 4.7 && < 5, QuickCheck
    hs-source-dirs:   src
    default-language: Haskell2010

test-suite hs2json-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base >= 4.7 && < 5, hs2json, QuickCheck
    default-language: Haskell2010

executable hs2json
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base >= 4.7 && < 5,
        hs2json

    hs-source-dirs:   app
    default-language: Haskell2010
