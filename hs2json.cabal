cabal-version:      3.0
name:               hs2json
version:            0.1.0.0
-- synopsis:
-- description:
license:            MIT
license-file:       LICENSE
author:             Milena Freire Britto Neves, Ana Iara Loayza Costa
maintainer:         milena.neves@discente.ufma.br
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  SimpleJSON, PutJSON, Prettify, PrettyJSON
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.20.2.0
    hs-source-dirs:   src
    default-language: Haskell2010

executable hs2json
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.20.2.0,
        hs2json

    hs-source-dirs:   app
    default-language: Haskell2010
